#!/usr/bin/env bash
# One-command setup: clone → ./script/bootstrap → repo is ready to work.
# Installs deps from the pinned lockfile and typechecks. Exits 0 on a clean
# checkout (the by-design failing test is NOT run here — see ./script/verify).
set -euo pipefail
cd "$(dirname "$0")/.."

echo "→ bun install --frozen-lockfile"
bun install --frozen-lockfile

echo "→ bun run typecheck"
bun run typecheck

echo "✓ bootstrap complete (run ./script/verify to execute the test suite)"
